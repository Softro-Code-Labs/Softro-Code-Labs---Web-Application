# Settings for the enquiry form (src/app/api/contact/route.ts).
# Copy this file to .env.local and fill in the real values. Never commit .env.local.
# On the live site, add the same variables in Vercel > Settings > Environment Variables.
#
# The rest of the site runs without any of these. The form needs at least one of the
# two groups below (email or CRM); each enquiry goes to every group that is set up.

# ----- Email, sent through Resend (resend.com) -----
# Your Resend API key. Secret: never share it.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Where enquiries are delivered.
CONTACT_TO_EMAIL=hello@softrocodelabs.com
# The sender. Must be an address on the domain verified in Resend.
CONTACT_FROM_EMAIL="Softro website <website@softrocodelabs.com>"

# ----- Softro CRM: each enquiry also becomes a lead there -----
# The CRM's address (no trailing path).
CRM_URL=https://softro-code-labs-crm-system.vercel.app
# The same value as WEBSITE_LEAD_API_KEY in the CRM. Secret: never share it.
CRM_LEAD_API_KEY=
